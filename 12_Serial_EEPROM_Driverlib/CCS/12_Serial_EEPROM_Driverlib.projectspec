<projectSpec>
  <project
        name="12_Serial_EEPROM_Driverlib"
        device="TMS320F28P650DK9"
        cgtVersion="22.6.3.LTS"
        products="C2000WARE"
        outputFormat="ELF"
        launchWizard="False"
        linkerCommandFile=""
        >
    <!--
      자기완결형(self-contained) 프로젝트입니다. SysConfig는 쓰지 않습니다.
      device.h/device.c/driverlib 헤더 전체/driverlib.lib/utils(콘솔 보조)를 전부 프로젝트 폴더 안에 복사해 두었으므로,
      C2000Ware 설치 경로와 무관하게 빌드됩니다. test/(PC용 호스트 테스트)는 일부러 복사하지 않습니다.
    -->
    <configuration name="CPU1_RAM"
        compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT} -I${PROJECT_ROOT}/device -I${PROJECT_ROOT}/device/driverlib -I${PROJECT_ROOT}/utils -v28 -ml -mt --cla_support=cla2 --define=RAM --float_support=fpu64 --tmu_support=tmu1 --define=DEBUG --define=CPU1 --gen_func_subsections=on --diag_warning=225 --diag_suppress=10063"
        linkerBuildOptions="--entry_point code_start --stack_size=0x600 --heap_size=0x0 -i${PROJECT_ROOT}" />
    <configuration name="CPU1_FLASH"
        compilerBuildOptions="--opt_level=off -I${PROJECT_ROOT} -I${PROJECT_ROOT}/device -I${PROJECT_ROOT}/device/driverlib -I${PROJECT_ROOT}/utils --define=_FLASH -v28 -ml -mt --cla_support=cla2 --float_support=fpu64 --tmu_support=tmu1 --define=DEBUG --define=CPU1 --gen_func_subsections=on --diag_warning=225 --diag_suppress=10063"
        linkerBuildOptions="--entry_point code_start --stack_size=0x600 --heap_size=0x0 --define=_FLASH -i${PROJECT_ROOT}" />

    <file action="copy" path="../driverlib.lib" targetDirectory="" applicableConfigurations="CPU1_RAM, CPU1_FLASH" />
    <file action="copy" path="../28p65x_generic_ram_lnk_cpu1.cmd" targetDirectory="" applicableConfigurations="CPU1_RAM" />
    <file action="copy" path="../28p65x_generic_flash_lnk_cpu1.cmd" targetDirectory="" applicableConfigurations="CPU1_FLASH" />
    <file action="copy" path="../targetConfigs/TMS320F28P650DK9.ccxml" targetDirectory="targetConfigs" />
    <file action="copy" path="../device" targetDirectory="" />
    <file action="copy" path="../utils" targetDirectory="" />
    <file action="copy" path="../m95m04.h" targetDirectory="" />
    <file action="copy" path="../m95m04.c" targetDirectory="" />
    <file action="copy" path="../m95m04_hal.c" targetDirectory="" />
    <file action="copy" path="../eeprom_cmds.h" targetDirectory="" />
    <file action="copy" path="../eeprom_cmds.c" targetDirectory="" />
    <file action="copy" path="../12_Serial_EEPROM_Driverlib.c" targetDirectory="" />
  </project>
</projectSpec>
